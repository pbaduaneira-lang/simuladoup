{
  "name": "simulado-up",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3005",
    "build": "node scripts/check-catalogue.mjs && next build --webpack",
    "start": "next start -p 3005",
    "lint": "eslint src tests scripts/*.mjs scripts/lib/*.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "catalogue:check": "node scripts/check-catalogue.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write src scripts/*.mjs scripts/lib/*.mjs tests README.md docs/*.md"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.44.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "prettier": "^3.8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
