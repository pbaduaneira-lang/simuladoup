# Desenvolvimento local usa SQLite quando TURSO_DATABASE_URL não é definido.
# Produção exige um banco remoto e um token de acesso com permissão de leitura/escrita.
# TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
# TURSO_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3005
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
